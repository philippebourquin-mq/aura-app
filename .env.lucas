# Loaded by `npm run build` (vite --mode lucas) — the player's app, at the site root.
# Not named plain ".env": that filename is gitignored (reserved for local secrets) and
# this needs to be committed for the CI build to produce the locked, correctly-iconed app.
VITE_APP_ROLE=lucas
VITE_ICON_HREF=aura-icon.svg
VITE_APPLE_ICON_HREF=apple-touch-icon.png
VITE_MANIFEST_HREF=manifest.webmanifest
VITE_APP_TITLE=AURA — Défis
VITE_THEME_COLOR="#F5EFDE"
