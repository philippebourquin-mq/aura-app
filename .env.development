# `npm run dev` only — same look as the Lucas app, but role stays unlocked so both
# sides stay testable from one browser via the switcher while working on the app.
VITE_APP_ROLE=
VITE_ICON_HREF=aura-icon.svg
VITE_APPLE_ICON_HREF=apple-touch-icon.png
VITE_MANIFEST_HREF=manifest.webmanifest
VITE_APP_TITLE=AURA — Défis
VITE_THEME_COLOR="#F5EFDE"
